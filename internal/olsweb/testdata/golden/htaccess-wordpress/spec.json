{
  "listeners": [
    {"name": "http", "address": "*", "port": 80}
  ],
  "sites": [
    {
      "name": "blog",
      "username": "blogowner",
      "group": "blogowner",
      "domains": ["example.com", "www.example.com"],
      "doc_root": "/home/blogowner/public_html",
      "php_version": "8.3",
      "limits": {"php_children": 4},
      "isolation": {"namespace": true, "cgroups": true},
      "redirects": [
        {"path": "/shop", "target": "https://shop.example.com/", "status": 302}
      ],
      "folders": [
        {"path": "/", "hosts": "all",
         "deny": {"names": [".htaccess", ".user.ini", "readme.html", "wp-config.php", "xmlrpc.php"], "endings": [".sql"]}},
        {"path": "/members/", "hosts": "all",
         "realm": {"name": "Members only", "user_file": "/var/lib/sifruno-realms/blog/realm2.htpasswd"},
         "deny": {"names": [".htpasswd"]}},
        {"path": "/private/", "hosts": "none"},
        {"path": "/wp-content/uploads/", "hosts": "all", "deny": {"endings": [".php"]}}
      ],
      "htaccess_redirects": [
        {"prefix": "/old-page", "target": "https://example.com/new-page", "status": 301},
        {"prefix": "/docs/", "target": "/manual/", "status": 302},
        {"pattern": "^/blog/([0-9]+)/(.*)$", "target": "/news/$2?id=$1", "status": 301}
      ],
      "error_pages": [
        {"status": 403, "url": "/errors/403.html"},
        {"status": 404, "url": "/404.html"}
      ]
    },
    {
      "name": "paused",
      "username": "pauseduser",
      "group": "pauseduser",
      "domains": ["paused.example.org"],
      "doc_root": "/home/pauseduser/public_html",
      "php_version": "8.2",
      "suspended": true,
      "folders": [
        {"path": "/", "hosts": "all", "deny": {"names": ["wp-config.php"]}}
      ],
      "htaccess_redirects": [
        {"prefix": "/old", "target": "/new", "status": 301}
      ],
      "error_pages": [
        {"status": 404, "url": "/404.html"}
      ]
    }
  ]
}
