{
  "listeners": [
    {"name": "http", "address": "*", "port": 80},
    {"name": "https", "address": "*", "port": 443, "secure": true,
     "cert_file": "/etc/sifruno/tls/listener.crt",
     "key_file": "/etc/sifruno/tls/listener.key"}
  ],
  "sites": [
    {
      "name": "shop",
      "username": "shopowner",
      "group": "shopowner",
      "domains": ["shop.example.com"],
      "doc_root": "/home/shopowner/public_html",
      "php_version": "8.3",
      "limits": {"php_children": 4},
      "isolation": {"namespace": true},
      "tls": {
        "cert_file": "/etc/sifruno/tls/shop/cert.pem",
        "key_file": "/etc/sifruno/tls/shop/key.pem"
      }
    },
    {
      "name": "plain",
      "username": "plainowner",
      "group": "plainowner",
      "domains": ["plain.example.net"],
      "doc_root": "/home/plainowner/public_html",
      "php_version": "8.2",
      "limits": {"php_children": 4},
      "isolation": {"namespace": true},
      "tls": {}
    }
  ]
}
