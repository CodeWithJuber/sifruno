{
  "listeners": [
    {"name": "http", "address": "*", "port": 80}
  ],
  "sites": [
    {
      "name": "blog",
      "username": "blogowner",
      "group": "blogowner",
      "domains": ["example.com", "www.example.com"],
      "doc_root": "/home/blogowner/public_html",
      "php_version": "8.3",
      "limits": {"php_children": 4},
      "isolation": {"namespace": true, "cgroups": true},
      "folders": [
        {"path": "/internal/", "hosts": "only", "networks": ["192.0.2.0/24", "198.51.100.7/32", "2001:db8::/32"]},
        {"path": "/members/", "hosts": "all",
         "realm": {"name": "Members only", "user_file": "/var/lib/sifruno-realms/blog/realm2.htpasswd"}},
        {"path": "/staff/", "hosts": "except", "networks": ["203.0.113.0/24"],
         "realm": {"name": "Staff", "user_file": "/var/lib/sifruno-realms/blog/realm3.htpasswd", "users": ["alice", "bob"]}},
        {"path": "/wp-content/plugins/akismet/", "hosts": "none",
         "allow": ["akismet.css", "akismet.js", "form.js", "logo-a-2x.png"]},
        {"path": "/wp-content/uploads/private.files/", "hosts": "none"}
      ]
    },
    {
      "name": "paused",
      "username": "pauseduser",
      "group": "pauseduser",
      "domains": ["paused.example.org"],
      "doc_root": "/home/pauseduser/public_html",
      "php_version": "8.2",
      "suspended": true,
      "folders": [
        {"path": "/members/", "hosts": "all",
         "realm": {"name": "Members", "user_file": "/var/lib/sifruno-realms/paused/realm1.htpasswd"}}
      ]
    }
  ]
