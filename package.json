{
  "name": "sifruno-workbench",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Evidence and recovery workbench for the zero-change hosting compatibility project",
  "scripts": {
    "panel:build": "npm --prefix web run build",
    "panel:dev": "npm --prefix web run dev",
    "panel:typecheck": "npm --prefix web run typecheck",
    "runtime:build": "node scripts/build-runtime.mjs",
    "brand:build": "node scripts/brand-build.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:preview": "node scripts/brand-server.mjs",
    "brand:browser-check": "node scripts/brand-browser-check.mjs",
    "test:tools": "npm run brand:check && npm run brand:browser-check",
    "check:workflows": "bash scripts/ci/public-repo-guard.sh"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@zip.js/zip.js": "2.25.0",
    "lucide-static": "1.78.0",
    "opentype.js": "2.0.0",
    "playwright": "1.65.1",
    "sharp": "0.35.5"
  }
}
