# Preserve approved brand asset hash bytes on every checkout.
assets/brand/** -text

# The Akismet .htaccess WordPress ships, byte for byte (its SHA-256 is pinned).
internal/htaccess/testdata/*.htaccess -text -whitespace
# PCM ledger logs are hash-deduped append-only sets - union merge is conflict-free (forge)
.forge/ledger/*/*.log merge=union
